    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst item = $input.first();\nconst text = item.json.text || '';\nconst pages = item.json.numpages || null;\n\n// The Extract node drops binary metadata, so reach back to the source node.\nconst fileInfo = $('Read/Write Files from Disk').first().binary.data;\nconst filename = fileInfo.fileName;\n\n// SHA-256 of the extracted text. In WF1 this hashes the raw file bytes;\n// here it just proves the crypto module is importable.\nconst fileHash = crypto.createHash('sha256').update(text).digest('hex');\n\nreturn [{\n  json: {\n    filename: filename,\n    file_hash: fileHash,\n    page_count: pages,\n    doc_type: 'contract',\n    status: 'extracted',\n    char_count: text.length,\n  },\n}];"
      },
