      "id": "19b7ea35-3130-467c-8957-85512b80f403",
      "name": "Save PDF"
    },
    {
      "parameters": {
        "jsCode": "// The Postgres node replaces its input with query results, so both the\n// binary PDF and our JSON fields were dropped. Reach back to the last\n// node that had them and reattach the duplicate-check outcome.\n\n// Where ingested PDFs live inside the container. This maps to\n// ./data/n8n_files/ingested on the host via docker-compose.\n// Defined ONCE here; Save PDF and Insert Document both read it.\nconst STORAGE_DIR = '/files/ingested';\n\nconst source = $('Compute File Hash').all();\nconst dupRows = $input.all();\nconst out = [];\n\nfor (let i = 0; i < source.length; i++) {\n  const row = dupRows[i] ? dupRows[i].json : {};\n  const json = { ...source[i].json };\n\n  // Content-addressed: the file is named by its own hash.\n  json.storage_path = `${STORAGE_DIR}/${json.file_hash}.pdf`;\n\n  // Only set the key when a match was actually found, so the IF node\n  // can test \"exists\" rather than \"is not null\".\n  if (row && row.id !== undefined && row.id !== null) {\n    json.existing_id = row.id;\n    json.existing_filename = row.filename;\n    json.existing_uploaded_at = row.uploaded_at;\n  }\n\n  out.push({ json, binary: source[i].binary });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        80
      ],
      "id": "1eac4c57-b927-4869-b868-8b7f3452fe08",
      "name": "Restore Context"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO documents (filename, file_hash, drive_url, doc_type, status)\nVALUES ($1, $2, $3, 'contract', 'uploaded')\nON CONFLICT (file_hash) DO NOTHING\nRETURNING id, filename, file_hash, status, uploaded_at;",
        "options": {
          "queryReplacement": "={{ [$json.filename, $json.file_hash, $json.storage_path] }}"
        }
