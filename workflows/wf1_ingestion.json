    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst out = [];\n\nfor (const item of $input.all()) {\n  const binaryKey = 'file';\n\n  if (!item.binary || !item.binary[binaryKey]) {\n    throw new Error(\n      `No binary data under key \"${binaryKey}\". ` +\n      `Found: ${item.binary ? Object.keys(item.binary).join(', ') : 'none'}`\n    );\n  }\n\n  const buffer = await this.helpers.getBinaryDataBuffer(\n    out.length,\n    binaryKey\n  );\n\n  const fileHash = crypto\n    .createHash('sha256')\n    .update(buffer)\n    .digest('hex');\n\n  out.push({\n    json: {\n      ...item.json,\n      file_hash: fileHash,\n      file_size_bytes: buffer.length,\n    },\n    binary: item.binary,\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
