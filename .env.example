# Copy this file to .env and fill in real values.
# .env.example is committed (fake values). .env is never committed.

# Supabase Session pooler string.
# Dashboard -> Connect -> Session pooler.
# Host must contain pooler.supabase.com and port must be 5432.
# Password must be ALPHANUMERIC ONLY - symbols break URL parsing.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:FAKEpassword123ABC@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Used by WF3 for clause extraction. Set in Phase 1.
OPENAI_API_KEY=sk-proj-FAKEKEYFAKEKEYFAKEKEY