# Copy this file to .env and fill in real values.
# .env.example is committed (fake values). .env is never committed.

# Supabase Session pooler string.
# Dashboard -> Connect -> Session pooler.
# Host must contain pooler.supabase.com and port must be 5432.
# Password must be ALPHANUMERIC ONLY - symbols break URL parsing.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:FAKEpassword123ABC@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Used by WF3 for clause extraction. Set in Phase 1.
OPENAI_API_KEY=sk-proj-FAKEKEYFAKEKEYFAKEKEY

N8N_ENCRYPTION_KEY=generate_with_python_secrets_token_hex_24
GENERIC_TIMEZONE=Asia/Kolkata

# Who receives WF4 clause review requests
REVIEW_EMAIL=lawyer@example.com

# Public base URL n8n builds webhook + resume links from.
# Localhost is fine for a same-machine demo; use a tunnel or
# real host for anything clicked from another device.
WEBHOOK_URL=http://localhost:5678/

N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Asia/Kolkata
OPENAI_API_KEY=sk-your-key-here